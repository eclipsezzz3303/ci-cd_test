# 基础镜像：从一个已经装好 Python 3.11 的官方镜像开始                                                                                                                                                                                                               
# slim 版本体积小，适合生产                                                                                                                                                                                                                                         
FROM python:3.11-slim                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                                    
# 设置容器内的工作目录，后续命令都在这个目录下执行                                                                                                                                                                                                                  
WORKDIR /app                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                    
# 先只复制依赖清单（利用 Docker 缓存：依赖没变时不用重新安装，构建更快）                                                                                                                                                                                            
COPY requirements.txt .                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                                    
# 安装依赖。--no-cache-dir 不保留 pip 缓存，让镜像更小                                                                                                                                                                                                              
RUN pip install --no-cache-dir -r requirements.txt                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                                    
# 把 src 目录复制到容器的 /app/src                                                                                                                                                                                                                                  
COPY src/ ./src/                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                                    
# 声明容器对外暴露 5000 端口（文档作用，提示这个服务用 5000）                                                                                                                                                                                                       
EXPOSE 5000                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                    
# 容器启动时执行的命令：进入 src 目录运行 app.py                                                                                                                                                                                                                    
# 相当于在容器里跑 python src/app.py                                                                                                                                                                                                                                
CMD ["python", "src/app.py"]